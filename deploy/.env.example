# Copy to deploy/.env only if you need to change a value. Compose reads these names
# from the shell environment; an absent file keeps the defaults below.

# Host interface that receives the published port. Keep 127.0.0.1 on a personal PC.
URP_PUBLISH_HOST=127.0.0.1
URP_PORT=4100

# Comma-separated Host names, in addition to localhost, if you open the bench by a LAN name.
URP_EXTRA_HOSTS=

# Leave empty. Set a long random value only if a non-loopback client must call /lab/api/shutdown.
URP_ADMIN_TOKEN=

# 1 uses llvmpipe / software OpenGL. Set 0 only together with deploy/docker-compose.gpu.yml.
LIBGL_ALWAYS_SOFTWARE=1

# The fingerprint-checked ROS overlays are not in git. Leaving these at 1 makes a fresh
# simulation image refuse a rebuilt bridge that does not match the owner's binary.
# URP_BRIDGE_FIX=0
# URP_TF_FIX=0
# URP_GUI_FIX=0
