<?xml version="1.0"?>
<!-- SYNTHETIC metric engineering fixture, not a measured greenhouse or benchmark mapping. -->
<sdf version="1.8"><world name="urp_synthetic_greenhouse">
  <gravity>0 0 -9.81</gravity>
  <physics name="physics" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
  <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
  <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
  <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
  <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
  <light name="sun" type="directional"><pose>0 0 8 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.4 0.2 -1</direction></light>
  <model name="ground"><static>true</static><link name="ground">
    <collision name="ground"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
    <visual name="ground"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry><material><ambient>0.55 0.5 0.4 1</ambient><diffuse>0.55 0.5 0.4 1</diffuse></material></visual>
  </link></model>
  <model name="west_wall"><static>true</static><pose>-2 0 0.5 0 0 0</pose><link name="body">
    <collision name="body"><geometry><box><size>0.1 8 1</size></box></geometry></collision>
    <visual name="body"><geometry><box><size>0.1 8 1</size></box></geometry><material><ambient>0.65 0.8 0.85 1</ambient><diffuse>0.65 0.8 0.85 1</diffuse></material></visual>
  </link></model>
  <model name="east_wall"><static>true</static><pose>10 0 0.5 0 0 0</pose><link name="body">
    <collision name="body"><geometry><box><size>0.1 8 1</size></box></geometry></collision>
    <visual name="body"><geometry><box><size>0.1 8 1</size></box></geometry><material><ambient>0.65 0.8 0.85 1</ambient><diffuse>0.65 0.8 0.85 1</diffuse></material></visual>
  </link></model>
  <model name="north_wall"><static>true</static><pose>4 4 0.5 0 0 0</pose><link name="body">
    <collision name="body"><geometry><box><size>12 0.1 1</size></box></geometry></collision>
    <visual name="body"><geometry><box><size>12 0.1 1</size></box></geometry><material><ambient>0.65 0.8 0.85 1</ambient><diffuse>0.65 0.8 0.85 1</diffuse></material></visual>
  </link></model>
  <model name="south_wall"><static>true</static><pose>4 -4 0.5 0 0 0</pose><link name="body">
    <collision name="body"><geometry><box><size>12 0.1 1</size></box></geometry></collision>
    <visual name="body"><geometry><box><size>12 0.1 1</size></box></geometry><material><ambient>0.65 0.8 0.85 1</ambient><diffuse>0.65 0.8 0.85 1</diffuse></material></visual>
  </link></model>
  <model name="north_crop_bed"><static>true</static><pose>4 2.4 0.35 0 0 0</pose><link name="body">
    <collision name="body"><geometry><box><size>6 1.2 0.7</size></box></geometry></collision>
    <visual name="body"><geometry><box><size>6 1.2 0.7</size></box></geometry><material><ambient>0.1 0.5 0.2 1</ambient><diffuse>0.1 0.5 0.2 1</diffuse></material></visual>
  </link></model>
  <model name="south_crop_bed"><static>true</static><pose>4 -2.4 0.35 0 0 0</pose><link name="body">
    <collision name="body"><geometry><box><size>6 1.2 0.7</size></box></geometry></collision>
    <visual name="body"><geometry><box><size>6 1.2 0.7</size></box></geometry><material><ambient>0.1 0.5 0.2 1</ambient><diffuse>0.1 0.5 0.2 1</diffuse></material></visual>
  </link></model>
  <!-- Start at world XY=(0,0), yaw=0. World and wheel odom start aligned in XY only. -->
  <model name="urp_synthetic_robot" canonical_link="base_link"><pose>0 0 0 0 0 0</pose>
    <link name="base_link"><pose>0 0 0.18 0 0 0</pose>
      <inertial><pose>-0.06 0 0 0 0 0</pose><mass>2</mass><inertia><ixx>0.018</ixx><iyy>0.04</iyy><izz>0.052</izz></inertia></inertial>
      <collision name="chassis"><geometry><box><size>0.45 0.30 0.12</size></box></geometry></collision>
      <visual name="chassis"><geometry><box><size>0.45 0.30 0.12</size></box></geometry><material><ambient>0.1 0.4 0.9 1</ambient><diffuse>0.1 0.4 0.9 1</diffuse></material></visual>
      <sensor name="imu" type="imu"><always_on>true</always_on><update_rate>50</update_rate><topic>/urp_synthetic/imu</topic><imu/></sensor>
    </link>
    <link name="left_wheel"><pose>0 0.19 0.1 -1.5707963267948966 0 0</pose>
      <inertial><mass>0.2</mass><inertia><ixx>0.00054</ixx><iyy>0.00054</iyy><izz>0.001</izz></inertia></inertial>
      <collision name="wheel"><geometry><cylinder><radius>0.10</radius><length>0.05</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="wheel"><geometry><cylinder><radius>0.10</radius><length>0.05</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    </link>
    <joint name="left_wheel_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <link name="right_wheel"><pose>0 -0.19 0.1 -1.5707963267948966 0 0</pose>
      <inertial><mass>0.2</mass><inertia><ixx>0.00054</ixx><iyy>0.00054</iyy><izz>0.001</izz></inertia></inertial>
      <collision name="wheel"><geometry><cylinder><radius>0.10</radius><length>0.05</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="wheel"><geometry><cylinder><radius>0.10</radius><length>0.05</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    </link>
    <joint name="right_wheel_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <link name="caster"><pose>-0.17 0 0.05 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.00005</ixx><iyy>0.00005</iyy><izz>0.00005</izz></inertia></inertial>
      <collision name="caster"><geometry><sphere><radius>0.05</radius></sphere></geometry><surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface></collision>
      <visual name="caster"><geometry><sphere><radius>0.05</radius></sphere></geometry></visual>
    </link>
    <joint name="caster_joint" type="fixed"><parent>base_link</parent><child>caster</child></joint>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.38</wheel_separation><wheel_radius>0.10</wheel_radius>
      <topic>/urp_synthetic/cmd_vel</topic><odom_topic>/urp_synthetic/odom</odom_topic><tf_topic>/urp_synthetic/tf</tf_topic>
      <frame_id>synthetic_odom</frame_id><child_frame_id>synthetic_base_footprint</child_frame_id><odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_velocity>0.25</max_linear_velocity><min_linear_velocity>-0.25</min_linear_velocity>
      <max_angular_velocity>0.7</max_angular_velocity><min_angular_velocity>-0.7</min_angular_velocity>
      <max_linear_acceleration>0.5</max_linear_acceleration><min_linear_acceleration>-0.5</min_linear_acceleration>
      <max_angular_acceleration>1.5</max_angular_acceleration><min_angular_acceleration>-1.5</min_angular_acceleration>
    </plugin>
    <!-- Physics pose evidence, independent of wheel integration. Not localization. -->
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_topic>/urp_synthetic/ground_truth</odom_topic><tf_topic>/urp_synthetic/ground_truth_tf_unused</tf_topic>
      <odom_frame>synthetic_world</odom_frame><robot_base_frame>synthetic_body</robot_base_frame>
      <dimensions>2</dimensions><odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </model>
</world></sdf>
