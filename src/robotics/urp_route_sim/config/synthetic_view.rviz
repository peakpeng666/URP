Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: synthetic_odom
    Background Color: 28; 31; 38
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Synthetic metric grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/Odometry
      Name: Synthetic wheel odometry
      Enabled: true
      Topic:
        Value: /urp_synthetic/odom
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Keep: 100
      Position Tolerance: 0.02
      Angle Tolerance: 0.02
    - Class: rviz_default_plugins/TF
      Name: Synthetic robot frames
      Enabled: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 70
      Target Frame: synthetic_odom
      X: 1
      Y: 0
Window Geometry:
  Width: 1200
  Height: 800
