        <inertial><mass>2</mass><inertia><ixx>0.012916666667</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.012916666667</iyy><iyz>0</iyz><izz>0.022500000000</izz></inertia></inertial>
        <visual name="visual"><geometry><cylinder><radius>0.15</radius><length>0.1000</length></cylinder></geometry><material><ambient>0.120 0.120 0.130 1.000</ambient><diffuse>0.120 0.120 0.130 1.000</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <collision name="collision"><geometry><cylinder><radius>0.15</radius><length>0.1000</length></cylinder></geometry>
