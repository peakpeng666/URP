<sdf version="1.8">
  <world name="physics_probe">
    <physics name="fast" type="ignored">
      <max_step_size>0.004</max_step_size>
      <dart><collision_detector>ode</collision_detector><solver><solver_type>dantzig</solver_type></solver></dart>
      <real_time_factor>4</real_time_factor>
    </physics>
    <gravity>0 0 -9.80665</gravity>
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics">
      <engine><filename>libignition-physics-dartsim-plugin.so</filename></engine>
    </plugin>
    <plugin filename="ignition-gazebo-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <scene><ambient>0.72 0.72 0.72 1</ambient><background>0.8 0.87 0.94 1</background><shadows>false</shadows><grid>false</grid></scene>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 80 0 0 0</pose>
      <diffuse>0.95 0.94 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.35 0.25 -0.9</direction>
    </light>
    <model name="ground"><static>true</static><pose>0.000 0.000 -0.01 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100.0 100.0</size></plane></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100.0 100.0</size></plane></geometry><material><ambient>0.470 0.630 0.360 1.000</ambient><diffuse>0.470 0.630 0.360 1.000</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
    </link></model>
    <model name="field"><static>true</static><link name="link">
      <visual name="field"><geometry><mesh><uri>/home/peakpeng/Desktop/URP/setup/2026-10-17/glm-acceptance/physics/step4ms-0/meshes/field.stl</uri></mesh></geometry><material><ambient>0.550 0.450 0.330 1.000</ambient><diffuse>0.550 0.450 0.330 1.000</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
    </link></model>
    <model name="depot"><static>true</static><pose>0.000 0.000 0 0 0 0</pose><link name="link">
      <visual name="pad"><pose>0 0 0.03 0 0 0</pose><geometry><box><size>3 3 0.04</size></box></geometry><material><ambient>0.620 0.620 0.600 1.000</ambient><diffuse>0.620 0.620 0.600 1.000</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
      <visual name="pole"><pose>0 0 1.5 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>3</length></cylinder></geometry><material><ambient>0.300 0.300 0.320 1.000</ambient><diffuse>0.300 0.300 0.320 1.000</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
      <visual name="flag"><pose>0.3 0 2.75 0 0 0</pose><geometry><box><size>0.6 0.02 0.4</size></box></geometry><material><ambient>0.950 0.750 0.100 1.000</ambient><diffuse>0.950 0.750 0.100 1.000</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
    </link></model>
    <model name="tasks"><static>true</static><link name="link">
      <visual name="task_1"><pose>2.000 0.000 0.35 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>0.7</length></cylinder></geometry><material><ambient>0.000 0.478 1.000 1.000</ambient><diffuse>0.000 0.478 1.000 1.000</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
    </link></model>
    <model name="vehicle_1">
      <pose>0 0 0.02 0 0 0.0</pose>
      <link name="chassis">
        <pose>0 0 0.250 0 0 0</pose>
        <inertial><mass>20.0</mass><inertia><ixx>0.603333333333</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.147333333333</iyy><iyz>0</iyz><izz>1.589333333333</izz></inertia></inertial>
        <visual name="body"><geometry><box><size>0.8 0.56 0.22</size></box></geometry><material><ambient>0.930 0.930 0.920 1.000</ambient><diffuse>0.930 0.930 0.920 1.000</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <visual name="top"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.7 0.5 0.03</size></box></geometry><material><ambient>0.000 0.478 1.000 1.000</ambient><diffuse>0.000 0.478 1.000 1.000</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <visual name="mast"><pose>-0.25 0 0.45 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.7</length></cylinder></geometry><material><ambient>0.300 0.300 0.320 1.000</ambient><diffuse>0.300 0.300 0.320 1.000</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <visual name="beacon"><pose>-0.25 0 0.82 0 0 0</pose><geometry><sphere><radius>0.09</radius></sphere></geometry><material><ambient>0.000 0.478 1.000 1.000</ambient><diffuse>0.000 0.478 1.000 1.000</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <visual name="front"><pose>0.41 0 0.02 0 0 0</pose><geometry><box><size>0.02 0.4 0.08</size></box></geometry><material><ambient>0.150 0.150 0.160 1.000</ambient><diffuse>0.150 0.150 0.160 1.000</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <collision name="collision"><geometry><box><size>0.8 0.56 0.22</size></box></geometry>
